# =============================================================================
# tripaw-server 환경변수 템플릿
#
# 사용법: 이 파일을 .env 로 복사한 뒤 각 값을 채워 넣으세요.
#   cp .env.example .env
#
# 발급처와 무료 한도는 data-docs/data-sources.md 참고.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 공공데이터포털 (data.go.kr) — 관광공사 TourAPI 등 공공 API 전체
#
# 인증키는 계정당 1개가 발급되어 승인받은 모든 API에 공통으로 사용됩니다.
# (마이페이지 > 인증키 발급현황 > 일반 인증키)
#
# 발급: https://www.data.go.kr 회원가입 → 아래 API별로 "활용신청"
#   - 반려동물 동반여행 서비스 (필수, 공모전 조건)
#     https://www.data.go.kr/data/15135102/openapi.do
#   - 국문 관광정보 서비스 (이미지/영업시간 보강)
#     https://www.data.go.kr/data/15101578/openapi.do
#   - 관광지별 연관 관광지 정보 (AI 루트 추천 근거)
#     https://www.data.go.kr/data/15128560/openapi.do
#   - 기상청 단기예보 / 중기예보 (루트 날씨 반영)
#     https://www.data.go.kr/data/15084084/openapi.do
#     https://www.data.go.kr/data/15059468/openapi.do
#   - 한국천문연구원 특일 정보 (공휴일/영업일 판단)
#     https://www.data.go.kr/data/15012690/openapi.do
#   - 소상공인시장진흥공단 상가정보 (주변 편의시설 보강)
#     https://www.data.go.kr/data/15012005/openapi.do
#
# 무료 한도: 개발계정 API별 1,000~10,000건/일 (운영계정 전환 시 증량 가능)
# -----------------------------------------------------------------------------

# 디코딩 인증키 (URL 인코딩되지 않은 원본 키). 대부분의 HTTP 클라이언트가
# 쿼리 파라미터를 자동 인코딩하므로 보통 이 값을 쓰면 됩니다.
DATA_GO_KR_SERVICE_KEY=

# 인코딩 인증키 (%2B, %3D 등이 포함된 형태). URL을 직접 조립해서
# 재인코딩을 피해야 할 때만 사용.
DATA_GO_KR_SERVICE_KEY_ENCODED=


# -----------------------------------------------------------------------------
# 2. 카카오 디벨로퍼스 — 지도 / 장소 검색 / 내비 실행
#
# 발급: https://developers.kakao.com → 내 애플리케이션 추가 → 앱 키
# 하나의 애플리케이션에서 아래 4종류 키가 함께 발급됩니다.
# -----------------------------------------------------------------------------

# REST API 키 — 서버에서 사용.
#   · 카카오 로컬 API (키워드 장소 검색, 좌표↔주소 변환) 각 일 100,000건 무료
#   · 카카오모빌리티 길찾기 REST API (아래 항목과 동일한 키 사용)
# 호출 시 헤더: Authorization: KakaoAK ${KAKAO_REST_API_KEY}
KAKAO_REST_API_KEY=

# JavaScript 키 — 웹에서 지도 표시(일 300,000건 무료) 및
# JS SDK 카카오내비 실행(Kakao.Navi.start, 경유지 최대 3개)에 사용.
KAKAO_JAVASCRIPT_KEY=

# 네이티브 앱 키 — 모바일 앱에서 카카오내비 SDK로 길안내 실행할 때 사용.
# (서버에서는 불필요하나, 클라이언트 전달/문서화 목적으로 함께 관리)
# 참고: 카카오내비 경유지 한도 3개 → 초과 시 카카오맵 스킴(5개)으로 폴백 필요.
KAKAO_NATIVE_APP_KEY=

# Admin 키 — 서버 관리자 권한 API용. 현재 Discovery 범위에서는 미사용.
# 유출 시 영향이 크므로 실제로 필요해질 때만 채우세요.
KAKAO_ADMIN_KEY=

# 앱 ID — 카카오 로그인에서 사용. 위 키들과 같은 애플리케이션의 숫자 ID입니다.
#   확인: 내 애플리케이션 → 앱 설정 → 앱 키 상단의 "앱 ID"
#
# 앱이 보낸 카카오 액세스 토큰이 정말 우리 앱에서 발급된 것인지 확인하는 데 씁니다.
# 카카오 액세스 토큰은 그냥 문자열이라 그 자체로는 출처를 알 수 없어서, 이 값이
# 없으면 남의 앱에서 발급받은 토큰으로도 우리 서비스에 계정을 만들 수 있습니다.
# 비워두면 그 검사를 건너뜁니다(로컬 개발용). 운영에서는 반드시 채우세요.
KAKAO_APP_ID=

# 심사위원용 테스트 계정 로그인(POST /api/auth/test) 스위치.
#
# true 면 소셜 로그인 없이 버튼 하나로 고정 계정에 들어올 수 있습니다. 입력값을
# 받지 않으므로 주소를 아는 사람은 누구나 그 계정에 들어옵니다. 심사 기간에만
# 켜고 끝나면 false 로 돌리세요(재배포 없이 라우트가 내려갑니다).
TEST_LOGIN_ENABLED=false


# -----------------------------------------------------------------------------
# 3. 카카오모빌리티 — 루트 이동시간 계산 (선택: 위 REST 키와 동일할 수 있음)
#
# 문서: https://developers.kakaomobility.com
#   · 자동차 길찾기      GET  /v1/directions            경유지 5개,  일 10,000건 무료
#   · 다중 경유지 길찾기  POST /v1/waypoints/directions  경유지 30개, 일  5,000건 무료
#     → 구간별 duration/distance 제공. AI 루트 총 이동시간 계산의 핵심.
#
# 기본적으로 카카오 디벨로퍼스의 REST API 키를 그대로 사용합니다.
# 별도 키를 발급받은 경우에만 아래에 채우고, 비워두면 KAKAO_REST_API_KEY 사용.
# -----------------------------------------------------------------------------
KAKAO_MOBILITY_REST_API_KEY=


# -----------------------------------------------------------------------------
# 4. ODsay — 대중교통 경로 탐색 (이동수단 = 대중교통 선택 시)
#
# 발급: https://lab.odsay.com → 회원가입 → API 키 신청
# 무료 한도: Basic 1,000회/일 (개인·학생·5인 이하 스타트업 대상)
# 주의: 전국 단위 대중교통 "경로안내"를 제공하는 공공 대안이 없어 사실상 유일한 선택지.
#       규모가 커지면 유료(Standard) 전환 필요.
# -----------------------------------------------------------------------------
ODSAY_API_KEY=


# -----------------------------------------------------------------------------
# 5. Google Gemini API (AI Studio) — AI 여행 루트 생성
#
# 발급: https://aistudio.google.com/apikey
# 용도: 기간·동반 반려동물·테마를 반영해 일차별 코스를 생성
#
# 비워 두어도 서버는 뜬다. POST /api/trips/{id}/generate 가 LLM 대신
# 자체 랭킹 순서로 코스를 짠다(응답 형태는 같다).
#
# 무료 플랜은 분당·일별 호출 한도가 있다. 한도를 넘기면 429 가 오고
# 서버는 랭킹 폴백으로 응답한다 — 사용자에게 빈 화면이 가지는 않는다.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# 사용할 모델 ID. AI Studio 에서 계정이 쓸 수 있는 모델명을 확인하고 맞춘다.
GEMINI_MODEL=gemini-3.1-flash-lite


# -----------------------------------------------------------------------------
# 6. 서버 기본 설정
# -----------------------------------------------------------------------------
APP_ENV=development
PORT=8080

# 데이터베이스 연결 문자열.
# 로컬은 docker-compose.yml 의 설정과 일치. `docker compose up -d` 후 바로 사용 가능.
DATABASE_URL=postgres://tripaw:tripaw_local@localhost:5432/tripaw?sslmode=disable


# -----------------------------------------------------------------------------
# 7. 로그인 (애플 / 카카오)
#
# 앱에서 애플·카카오 SDK 로 로그인하면 서버가 그 결과를 공급자에게 확인하고,
# 우리 서비스 토큰(JWT)을 발급합니다. 카카오 앱 ID 는 위 2번 항목에 있습니다.
# -----------------------------------------------------------------------------

# 우리 서비스 토큰(JWT)의 서명 키. 32바이트 이상이어야 서버가 뜹니다.
#   openssl rand -base64 32
# 이 값이 바뀌면 발급된 토큰이 전부 무효가 되어 모든 사용자가 다시 로그인해야 합니다.
JWT_SECRET=

# 토큰 수명. 비워두면 각각 1h / 720h(30일).
#   액세스  — API 호출에 쓰는 토큰. 새어도 피해 시간이 짧도록 짧게 잡습니다.
#   리프레시 — 액세스를 재발급받는 토큰. DB 에 해시로 저장되고 재발급 때마다 교체됩니다.
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=720h

# ── 애플 로그인 ────────────────────────────────────────────────
# 발급: https://developer.apple.com/account
#
# 애플 로그인은 iOS 에서만 제공합니다(안드로이드는 카카오만). 그래서 클라이언트가
# 하나뿐이고 아래 값 한 벌이면 됩니다. 나중에 안드로이드에도 붙이게 되면 별도
# Services ID 가 필요해서 설정을 한 벌 더 두어야 합니다.

# iOS 앱의 번들 ID. 애플이 주는 id_token 의 aud 와 대조합니다.
APPLE_CLIENT_ID=

# Membership 화면의 10자리 팀 ID.
APPLE_TEAM_ID=

# Keys → Sign in with Apple 용 키를 만들면 나오는 10자리 키 ID.
APPLE_KEY_ID=

# 위 키를 만들 때 한 번만 받을 수 있는 .p8 파일의 내용(PEM 전체).
# 줄바꿈을 \n 으로 바꿔 한 줄로 넣어도 됩니다.
#   예) APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=

# 앱 로그인에는 보통 필요 없습니다. 비워두면 애플에 전송하지 않습니다.
APPLE_REDIRECT_URI=
